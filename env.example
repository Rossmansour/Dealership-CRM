# Copy this file to .env and fill in your own key -- .env is gitignored
# so your key never gets committed or pushed to GitHub.

# Get a free key at https://aistudio.google.com/apikey
GEMINI_API_KEY=

# Optional -- defaults to gemini-3.6-flash if not set
GEMINI_MODEL=gemini-3.6-flash

# Get a free trial number at https://www.twilio.com/try-twilio
# Needed for the "Send Text" feature on a lead's profile
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_PHONE_NUMBER=
