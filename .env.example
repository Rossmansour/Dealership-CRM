# Copy this file to .env and fill in your own key -- .env is gitignored
# so your key never gets committed or pushed to GitHub.

# Required -- Postgres connection string (see "Setting up the database" in README)
DATABASE_URL=postgres://user:password@localhost:5432/dealership_crm

# Required -- encrypts SSNs and driver's license numbers in the database.
# Any random value of 32+ characters. Keep a copy somewhere safe: if it's
# lost, those encrypted values can never be read again. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
DATA_ENCRYPTION_KEY=

# Get a free key at https://aistudio.google.com/apikey
GEMINI_API_KEY=

# Optional -- defaults to gemini-3.6-flash if not set
GEMINI_MODEL=gemini-3.6-flash

# Get a free trial number at https://www.twilio.com/try-twilio
# Needed for the "Send Text" feature on a lead's profile
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_PHONE_NUMBER=
